<LabGridLayout@GridLayout>:
    # cols: 3
    rows: 2
    Button:
        text: "This is button 1"
        size_hint: .2, .1
    LabBoxLayout:
    Button:
        text: "This is button 3"
    Button:
        text: "This is button 4"
    Button:
        text: "This is button 5"
    Button:
        text: "This is button 6"

<LabAnchorLayout>:

    anchor_x: "center"
    anchor_y: "top"

    BoxLayout:
        size_hint: .25, .1
        orientation: "vertical"
        Button:
            text: "This is button 1"
        Button:
            text: "This is button 1"


<LabBoxLayout>:
    orientation: "horizontal"
    Button:
        text:
            "This is button 1"
        # size: "200sp", "50sp"
        # pos: "100dp", "100dp"
        size_hint: .5, None
        width: "50sp"
        pos_hint: {"center_y": .5}
        color: 0, 0, 1, 1
        background_color: 1, 0, 0, 1
    BoxLayout:
        orientation: "vertical"
        spacing: "100sp"
        Button:
            text:
                "This is button 2"
            size_hint: .8, 2.
            color: 1, 0, 0, 1
            background_color: 0, 0, 1, 1
        Button:
            text:
                "This is button 3"
            size_hint: .8, 2.
            color: 1, 0, 0, 1
            background_color: 0, 0, 1, 1
        Button:
            text:
                "This is button 4"
            size_hint: .8, 2.
            color: 1, 0, 0, 1
            background_color: 0, 0, 1, 1
        Button:
            text:
                "This is button 5"
            size_hint: .8, 2.
            color: 1, 0, 0, 1
            background_color: 0, 0, 1, 1

<LabWidget>:
    Button:
        text:
            "This is button 1"
        size: "200sp", "50sp"
        pos: "100dp", "100dp"
        color: 0, 0, 1, 1
    Label:
        text:
            "This is button 2"
        size: "200sp", "50sp"
        pos: "200dp", "200dp"
        color: 1, 0, 0, 1
