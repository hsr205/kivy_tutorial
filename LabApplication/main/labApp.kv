LabCounterGridLayout:

<LabCounterGridLayout>:
    cols: 2
    rows: 2
    Button:
        text: "Click me to increment the counter"
        on_press: root.increment_counter()
    Label:
        text: f"Counter {root.counter_int}"
        font_name: "../resources/1_THE_LAB/RESOURCES/fonts/Lcd.ttf"
        font_size: "20sp"
    Button:
        text: "Click me get a random value"
        on_press: root.get_random_float_value()
    Label:
        text: f"Counter {round(root.random_float, 2)}"
        font_name: "../resources/1_THE_LAB/RESOURCES/fonts/Lcd.ttf"
        font_size: "20sp"

